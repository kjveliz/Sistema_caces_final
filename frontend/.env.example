# Frontend (Vite). Copiar este archivo a ".env" dentro de frontend/ y
# completar según el entorno local. ".env" NO se sube a git.
#
# Nota: hoy la URL de la API sigue hardcodeada como
# "http://localhost/sistemacaces/api/..." en cada archivo de
# frontend/src/services/*.ts — esta variable queda lista para cuando se
# centralice esa URL (tarea de la Fase 4 del plan de mejora), todavía no
# está siendo leída por el código.

VITE_API_URL=http://localhost/sistemacaces/api
