# Opcional. Copiar a "frontend/e2e/.env.e2e" y exportar antes de correr los
# tests si tu BD de desarrollo no tiene el usuario demo de
# db/seeds/UsuariosSeeder.php, o si el backend/frontend no corren en las URLs
# por defecto. Ver INSTRUCCIONES_fase5_playwright.md.

E2E_EMAIL=administrador@demo.local
E2E_PASSWORD=CacesDemo2026!

# URL donde Playwright espera encontrar el frontend (levanta "npm run dev"
# si no hay nada corriendo ahí todavía).
E2E_BASE_URL=http://localhost:5173
